name: "Security and Dependency Scan"

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

jobs:
  security-scan:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.11'
      - name: Install tools
        run: |
          python -m pip install --upgrade pip
          pip install pip-audit bandit
      - name: Run pip-audit
        run: |
          pip-audit -f text || true
      - name: Run bandit
        run: |
          bandit -r . || true
